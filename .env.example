# -----------------------------------------------------------------------------
# Application Environment Configuration
# -----------------------------------------------------------------------------
APP_NAME="Enterprise AI Knowledge & Decision Agent"
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=true
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Provider options: "mock" (for tests/offline), "openai", "groq", "ollama", "azure"
LLM_PROVIDER="mock"

# Model name:
# e.g., "gpt-4o-mini", "llama-3.3-70b-versatile", "mistral:instruct"
LLM_MODEL="gpt-4o-mini"

# API Key (leave empty or set placeholder when LLM_PROVIDER="mock")
LLM_API_KEY=""

# Base URL for OpenAI-compatible gateways (vLLM, Ollama, Groq, LiteLLM, etc.)
# OpenAI: https://api.openai.com/v1
# Groq: https://api.groq.com/openai/v1
# Ollama: http://localhost:11434/v1
LLM_BASE_URL="https://api.openai.com/v1"

# Hyperparameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
