# -----------------------------------------------------------------------------
# Application Environment Configuration
# -----------------------------------------------------------------------------
APP_NAME="Enterprise AI Knowledge & Decision Agent"
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=true
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Provider options: "mock" (offline dev/test), "gemini", "openai", "groq", "ollama", "azure"
LLM_PROVIDER="mock"

# Model name:
# Gemini: "gemini-2.5-flash", "gemini-1.5-flash", "gemini-1.5-pro", "gemini-2.0-flash"
# OpenAI: "gpt-4o-mini", "gpt-4o"
LLM_MODEL="gemini-2.5-flash"

# Google Gemini API Key
GEMINI_API_KEY=""

# Generic / OpenAI API Key (used for OpenAI, Groq, or as fallback)
LLM_API_KEY=""

# Base URL for OpenAI-compatible gateways (vLLM, Ollama, Groq, LiteLLM, etc.)
LLM_BASE_URL="https://api.openai.com/v1"

# Hyperparameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Embedding Provider Configuration
# -----------------------------------------------------------------------------
# Provider options: "mock", "gemini", "openai"
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=64

# -----------------------------------------------------------------------------
# Qdrant Vector Database Configuration
# -----------------------------------------------------------------------------
# Leave QDRANT_URL empty or set to ":memory:" for zero-docker in-memory mode
# For local Docker: "http://localhost:6333"
# For Qdrant Cloud: "https://<cluster-id>.<region>.gcp.cloud.qdrant.io:6333"
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="enterprise_knowledge"
QDRANT_PREFER_GRPC=false

# -----------------------------------------------------------------------------
# Sparse Search (BM25 / Elasticsearch) & Hybrid Retrieval Configuration
# -----------------------------------------------------------------------------
# Provider options: "bm25" (in-memory offline), "elasticsearch" (remote cluster)
SPARSE_SEARCH_PROVIDER="bm25"
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_API_KEY=""
ELASTICSEARCH_INDEX_NAME="enterprise_knowledge"

# Hybrid Rank Fusion: "rrf" (Reciprocal Rank Fusion) or "linear"
HYBRID_FUSION_METHOD="rrf"
HYBRID_DENSE_WEIGHT=0.5
HYBRID_SPARSE_WEIGHT=0.5
RRF_K=60
