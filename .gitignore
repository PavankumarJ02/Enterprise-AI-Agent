# ==========================================================================
# Enterprise AI Agent - Comprehensive Git Ignore
# ==========================================================================

# 1. Byte-compiled / optimized / Python caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 2. Distribution / packaging / build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 3. Virtual Environments
.venv/
venv/
ENV/
env/
.env/

# 4. Environment variables & Secrets (NEVER COMMIT SENSITIVE KEYS)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt

# 5. Testing, Type Checking & Linting Caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 6. Node & Frontend dependencies
node_modules/
*/node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. Local Databases & Volatile Runtime State
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/*.db
data/*.sqlite
data/*.sqlite3
data/qdrant/
uploads/
scratch/

# 8. IDEs & Text Editors
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# 9. Operating System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
