# ==============================================================================
# Enterprise AI Agent - Docker Environment Configuration Template
# Copy this file to .env before starting containers: `cp .env.docker.example .env`
# ==============================================================================

# Application Environment & Server
APP_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration ("openai", "gemini", or "mock")
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# Embeddings Configuration ("gemini", "openai", or "mock")
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# Qdrant Vector Store Container
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=enterprise_knowledge

# SQLite State & Experiment Tracking Storage
SQLITE_DB_PATH=/app/data/enterprise.db
EXPERIMENTS_DB_PATH=/app/data/experiments.db

# Ingestion & Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Reranking & Retrieval
RERANKER_PROVIDER=flashrank
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
RETRIEVAL_HYBRID_ALPHA=0.6

# Guardrails & Security
GUARDRAILS_ENABLED=true
GUARDRAILS_BLOCK_INJECTIONS=true
GUARDRAILS_REDACT_PII=true

# Rate Limiting & Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST_LIMIT=30
SECURITY_HEADERS_ENABLED=true

# Observability & Distributed Tracing
OBSERVABILITY_ENABLED=true
OBSERVABILITY_EXPORTER=memory
# OBSERVABILITY_EXPORTER=otlp
# OBSERVABILITY_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
